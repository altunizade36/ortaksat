{
  "name": "ortaksat-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "android:clear": "expo start --android --clear",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:trust": "node scripts/check-trust-database.mjs && node scripts/check-trust-domain.mjs",
    "test:trust:ui": "node scripts/check-trust-ui.mjs",
    "test:mobile-auth": "node scripts/check-mobile-auth.mjs",
    "test:mobile-filters": "node scripts/check-mobile-filters.mjs",
    "test:mobile-catalogue": "node scripts/check-mobile-catalogue-ui.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "lint": "eslint app components lib data",
    "lint:hooks": "npm run lint",
    "quality": "npm run check:encoding && npm run lint:hooks && npm run typecheck && npm run doctor",
    "export:android": "expo export --platform android --output-dir dist-check-android",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:web": "node scripts/gen-og-maps.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-listing-seed.mjs && expo export --platform web --output-dir dist-web && node scripts/post-export.mjs && node scripts/indexnow.mjs",
    "serve:web": "npx http-server dist-web -p 8099 -s",
    "doctor": "npx expo-doctor",
    "build:android:preview": "eas build -p android --profile preview",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:internal": "eas build --profile preview",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "submit:android": "eas submit -p android --profile production",
    "submit:ios": "eas submit -p ios --profile production",
    "db:migrate": "node scripts/apply-supabase-migration.mjs",
    "db:apply-all": "node scripts/apply-all.mjs",
    "db:advisors": "node scripts/supabase-advisors.mjs",
    "backfill:thumbnails": "node scripts/backfill-thumbnails.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jimp": "^1.6.1",
    "pg": "^8.23.1",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo"
      ]
    }
  },
  "private": true,
  "overrides": {
    "zod": "^4.6.6",
    "minimatch@>=7.0.0 <=11.0.0": "^11.0.8"
  },
  "engines": {
    "node": "24.x"
  }
}
