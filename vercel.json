    },
    {
      "source": "/favorites",
      "destination": "/favoriler",
      "permanent": true
    },
    {
      "source": "/following",
      "destination": "/takip-ettiklerim",
      "permanent": true
    },
    {
      "source": "/messages",
      "destination": "/mesajlar",
      "permanent": true
    },
    {
      "source": "/notification-settings",
      "destination": "/bildirim-ayarlari",
      "permanent": true
    },
    {
      "source": "/notifications",
      "destination": "/bildirimler",
      "permanent": true
    },
    {
      "source": "/profile-edit",
      "destination": "/profil-duzenle",
      "permanent": true
    },
    {
