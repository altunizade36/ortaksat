  "rewrites": [
    {
      "source": "/ortaklik-basvurusu/:id",
      "destination": "/partnership-request/[id]"
    },
    {
      "source": "/ortaklik/:id",
      "destination": "/partnership/[id]"
    },
    {
      "source": "/ortak-satis",
      "destination": "/partner"
    },
    {
      "source": "/kesfet-akisi/:id",
      "destination": "/explore-feed/[id]"
    },
    {
      "source": "/kesfet",
      "destination": "/explore"
    },
    {
      "source": "/ilan-ver",
      "destination": "/create"
    },
    {
      "source": "/ilanlarim",
      "destination": "/seller"
    },
    {
      "source": "/ilan-duzenle/:id",
      "destination": "/listing-edit/[id]"
    },
    {
      "source": "/ilan-istatistik/:id",
      "destination": "/listing-stats/[id]"
    },
    {
      "source": "/ilan/:id",
      "destination": "/listing/[id]"
    },
    {
      "source": "/magaza/:id",
      "destination": "/store/[id]"
    },
    {
      "source": "/sohbet/:id",
      "destination": "/chat/[id]"
    },
    {
      "source": "/favoriler",
      "destination": "/favorites"
    },
    {
      "source": "/takip-ettiklerim",
      "destination": "/following"
    },
    {
      "source": "/mesajlar",
      "destination": "/messages"
    },
    {
      "source": "/bildirim-ayarlari",
      "destination": "/notification-settings"
    },
    {
      "source": "/bildirimler",
      "destination": "/notifications"
    },
    {
      "source": "/profil-duzenle",
      "destination": "/profile-edit"
    },
    {
      "source": "/profil",
      "destination": "/profile"
    },
    {
      "source": "/hesap-ayarlari",
      "destination": "/account-settings"
    },
    {
      "source": "/hesap-guvenligi",
      "destination": "/account-security"
    },
    {
      "source": "/giris",
      "destination": "/auth"
    },
    {
      "source": "/kazanclar",
      "destination": "/earnings"
    },
    {
      "source": "/teklifler",
      "destination": "/offers"
    },
    {
      "source": "/alici-talepleri",
      "destination": "/buyer-requests"
    },
    {
      "source": "/destek",
      "destination": "/support"
    },
    {
      "source": "/sikayetlerim",
      "destination": "/reports"
    },
    {
      "source": "/sikayet",
      "destination": "/report"
    },
    {
      "source": "/degerlendirme",
      "destination": "/review"
    },
    {
      "source": "/sozlesmeler",
      "destination": "/legal"
    },
    {
      "source": "/guven",
      "destination": "/trust"
    },
    {
      "source": "/araclar",
      "destination": "/market-tools"
    },
    {
      "source": "/ilan-araclari",
      "destination": "/mobile-tools"
    },
    {
      "source": "/yonetim",
      "destination": "/admin"
    },
    {
      "source": "/i/:slug",
      "destination": "/i/[slug]"
    },
    {
      "source": "/onay/:token",
      "destination": "/onay/[token]"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/[slug]"
    },
    {
      "source": "/kategori/:slug/:sehir",
      "destination": "/kategori/[slug]/[sehir]"
    },
    {
      "source": "/kategori/:slug",
      "destination": "/kategori/[slug]"
    },
    {
      "source": "/sayfa/:slug",
      "destination": "/sayfa/[slug]"
    },
    {
      "source": "/ortak/:id",
      "destination": "/ortak/[id]"
    },
    {
      "source": "/davet/:code",
      "destination": "/davet/[code]"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
