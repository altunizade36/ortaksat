      "permanent": true
    },
    {
      "source": "/kategori/bahce-ve-yasam",
      "destination": "/kategori/bahce-ve-yapi-market",
      "permanent": true
    },
    {
      "source": "/kategori/otomobil-markaya-gore",
      "destination": "/kategori/otomobil",
