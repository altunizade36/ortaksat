{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/kategori/muzik-enstrumanlari", "destination": "/kategori/muzik", "permanent": true },
    { "source": "/kategori/yapi-market-ve-bahce", "destination": "/kategori/bahce-ve-yapi-market", "permanent": true },
    { "source": "/kategori/dijital-urunler-ve-hizmetler", "destination": "/kategori/dijital-hizmetler", "permanent": true },
    { "source": "/kategori/yedek-parca-aksesuar-ve-tuning", "destination": "/kategori/yedek-parca-aksesuar-donanim-ve-tuning", "permanent": true },
    { "source": "/kategori/bahce-ve-yasam", "destination": "/kategori/bahce-ve-yapi-market", "permanent": true },
    { "source": "/kategori/otomobil-markaya-gore", "destination": "/kategori/otomobil", "permanent": true },
    { "source": "/kategori/otomobil-kasa-tipine-gore", "destination": "/kategori/otomobil", "permanent": true },
    { "source": "/kategori/motosiklet-markaya-gore", "destination": "/kategori/motosiklet", "permanent": true },
    { "source": "/kategori/elektrikli-ve-hibrit-araclar", "destination": "/kategori/elektrikli-araclar", "permanent": true },
    { "source": "/kategori/ev-yasam", "destination": "/kategori/ev-ve-yasam", "permanent": true },
    { "source": "/kategori/anne-bebek", "destination": "/kategori/anne-ve-bebek", "permanent": true },
    { "source": "/kategori/spor-outdoor", "destination": "/kategori/spor-ve-outdoor", "permanent": true },
    { "source": "/kategori/hobi-oyun", "destination": "/kategori/kitap-ve-hobi", "permanent": true }
  ],
  "rewrites": [
    { "source": "/i/:slug", "destination": "/i/[slug]" },
    { "source": "/onay/:token", "destination": "/onay/[token]" },
    { "source": "/blog/:slug", "destination": "/blog/[slug]" },
    { "source": "/listing/:id", "destination": "/listing/[id]" },
    { "source": "/kategori/:slug/:sehir", "destination": "/kategori/[slug]/[sehir]" },
    { "source": "/kategori/:slug", "destination": "/kategori/[slug]" },
    { "source": "/listing-edit/:id", "destination": "/listing-edit/[id]" },
    { "source": "/chat/:id", "destination": "/chat/[id]" },
    { "source": "/store/:id", "destination": "/store/[id]" },
    { "source": "/ortak/:id", "destination": "/ortak/[id]" },
    { "source": "/davet/:code", "destination": "/davet/[code]" },
    { "source": "/explore-feed/:id", "destination": "/explore-feed/[id]" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
