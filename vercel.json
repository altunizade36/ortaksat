      "permanent": true
    },
    {
      "source": "/earnings",
      "destination": "/kazanclar",
      "permanent": true
    },
    {
      "source": "/offers",
      "destination": "/teklifler",
      "permanent": true
    },
    {
      "source": "/buyer-requests",
      "destination": "/alici-talepleri",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/destek",
      "permanent": true
    },
    {
      "source": "/reports",
      "destination": "/sikayetlerim",
      "permanent": true
    },
    {
      "source": "/report",
