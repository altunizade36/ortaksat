# OrtakSat — .env şablonu. Gerçek değerleri .env'e yaz (.env git'e gitmez).
# EXPO_PUBLIC_* = uygulamaya gömülür (herkese açık). Diğerleri = gizli, yalnız
# yerel otomasyon scriptleri (scripts/) için; uygulamaya gömülmez.

# --- Uygulama (public) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Meta (Facebook) Pixel — boş bırakılırsa reklam takibi UYKUDA (env-gate'li). Vercel'e
# eklenince canlı olur; sahte/yanlış ID koyma.
EXPO_PUBLIC_META_PIXEL_ID=

# --- Supabase yönetim (gizli): auth/config + görsel backfill otomasyonu ---
SUPABASE_MGMT_TOKEN=sbp_xxx
SUPABASE_PROJECT_REF=your-project-ref
# service_role secret (Dashboard → Project Settings → API). YALNIZ yerel bakım scriptleri
# (ör. scripts/backfill-thumbnails.mjs --apply). ASLA istemciye/uygulamaya gömme.
SUPABASE_SERVICE_ROLE_KEY=eyJ_service_role_xxx

# --- Resend e-posta (gizli): SMTP Supabase'de kurulur ---
RESEND_API_KEY=re_xxx
RESEND_DOMAIN=ortaksat.com
EMAIL_FROM=no-reply@ortaksat.com

# --- Veritabanı (gizli): migration uygulamak için ---
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
POSTGRES_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Google OAuth (gizli): Supabase'de yeniden yapılandırma için ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- GoDaddy DNS (gizli, opsiyonel): DNS otomasyonu ---
GODADDY_KEY=your-godaddy-key
GODADDY_SECRET=your-godaddy-secret

# --- Vercel (gizli, opsiyonel): deploy otomasyonu ---
VERCEL_TOKEN=your-vercel-token
