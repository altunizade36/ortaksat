{
  "expo": {
    "name": "OrtakSat",
    "slug": "ortaksat-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "ortaksat",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ortaksat.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:ortaksat.com",
        "applinks:www.ortaksat.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "OrtakSat; ilan fotoğrafı ve videosu, profil fotoğrafı ve mesaj, destek, şikâyet ya da doğrulama eki seçebilmen için galerine erişir.",
        "NSCameraUsageDescription": "OrtakSat; ilan fotoğrafını ve profil fotoğrafını doğrudan çekebilmen için kameraya erişir.",
        "NSLocationWhenInUseUsageDescription": "OrtakSat; yakınındaki ilanları göstermek, ilan konumunu doldurmak ve istersen sohbette konum paylaşmak için konumunu kullanır.",
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.ortaksat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E5F0FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ortaksat.com",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "ortaksat.com",
              "pathPrefix": "/listing/"
            },
            {
              "scheme": "https",
              "host": "ortaksat.com",
              "pathPrefix": "/onay/"
            },
            {
              "scheme": "https",
              "host": "www.ortaksat.com",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "www.ortaksat.com",
              "pathPrefix": "/listing/"
            },
            {
              "scheme": "https",
              "host": "www.ortaksat.com",
              "pathPrefix": "/onay/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OrtakSat; ilan fotoğrafı ve videosu, profil fotoğrafı ve mesaj, destek, şikâyet ya da doğrulama eki seçebilmen için galerine erişir.",
          "cameraPermission": "OrtakSat; ilan fotoğrafını ve profil fotoğrafını doğrudan çekebilmen için kameraya erişir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/ring.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#E5F0FF"
        }
      ],
      "expo-localization",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0645C9"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OrtakSat; yakınındaki ilanları göstermek, ilan konumunu doldurmak ve istersen sohbette konum paylaşmak için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "OrtakSat; yakınındaki ilanları göstermek, ilan konumunu doldurmak ve istersen sohbette konum paylaşmak için konumunu kullanır.",
          "locationAlwaysPermission": "OrtakSat; yakınındaki ilanları göstermek, ilan konumunu doldurmak ve istersen sohbette konum paylaşmak için konumunu kullanır.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon-source.png",
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "privacyUrl": "https://www.ortaksat.com/gizlilik-politikasi",
      "supportUrl": "https://www.ortaksat.com/iletisim",
      "termsUrl": "https://www.ortaksat.com/kullanim-sartlari"
    }
  }
}
